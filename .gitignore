# WorkBuddy 项目数据（本机记忆，不入库）
.workbuddy/
.codebuddy/

# 运行时状态（顾问使用 Octopus Mate 时生成的客户项目目录）
workspace/
projects/
state/

# 运行产物（愿景会话工作目录，不随专家包发布，见开发计划 §5.1）
workshop/

# 真实客户素材（业务敏感，不入库；方法论蒸馏件在专家包内）
test-transcripts/
interviews/
references/*.pdf

# Python 测试与缓存
.pytest_cache/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 系统与临时文件
.DS_Store
Thumbs.db
*.tmp
*.log
tmp/
temp/

# 打包产物
dist/
build/
*.zip
*.tgz

# 内部文件
internal/

# 本地个人笔记（不入库）
notes-private/
