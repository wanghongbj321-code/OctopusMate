{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://octopus-mate.dev/schemas/manifest.schema.json",
  "title": "Method Manifest (vision-method / diagnosis-method)",
  "description": "方法插件 manifest.yaml 规范（对齐开发计划 §6.2 示例与 §4 输出契约字段全集）。每个方法是一个标准 Skill 包，manifest 声明步骤/gate/AI 约束/输出契约覆盖范围；非法 manifest 被注册器拒绝并返回字段级错误。v2（M0-03）：type 支持 diagnosis-method 分支，新增 scoring 节（打分规则声明，运行时由顾问确认覆盖）。",
  "type": "object",
  "required": [
    "name",
    "version",
    "type",
    "displayName",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(vision|diagnosis)-method-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "方法标识，必须为 vision-method-{slug} 或 diagnosis-method-{slug}（kebab-case）"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本号 MAJOR.MINOR.PATCH"
    },
    "type": {
      "enum": ["vision-method", "diagnosis-method"],
      "description": "方法类型：vision-method=愿景构建方法；diagnosis-method=诊断方法（如 VITAL）"
    },
    "displayName": {
      "type": "string",
      "description": "方法显示名（出现在「选择方法」列表）"
    },
    "fileGate": {
      "type": "boolean",
      "description": "是否启用文件级规则型 gate（G0：confirmed md + confirmation + hash + artifact manifest 校验）。开启后：步骤执行/出口/授权/渲染入口均检查 required artifacts（_engine/files.py）；未声明或 false 的方法（如 vision 域）不受影响。默认 false。"
    },
    "description": {
      "type": "string",
      "description": "一句话说明适用场景（出现在「选择方法」列表副标题）"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "步骤定义（首版线性流程 + 线性回溯，见 §7 M1-03）",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "步骤 id，如 \"01\"（全局唯一）"
          },
          "name": {
            "type": "string",
            "description": "步骤名"
          },
          "question": {
            "type": "string",
            "description": "向顾问提出的核心问题（AI 引导层读取并呈现）"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "操作指引"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "该步产出物"
          },
          "gate": {
            "type": "object",
            "description": "该步可选的三态 gate 判定；语义型判定由 AI 引导层执行（§6.4），规则型判定由引擎执行",
            "properties": {
              "coreCheck": {
                "type": "string",
                "description": "核心判定项说明；仅核心项失败才触发回指"
              },
              "pass": {
                "type": "string",
                "description": "通过标准"
              },
              "conditional": {
                "type": "string",
                "description": "有条件通过标准（登记未决项后可带项继续）"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "required": ["scale"],
      "description": "打分规则声明（仅 diagnosis-method 使用；作为默认参考呈现给顾问确认，运行时以 state.json.scoring_config 为准，见开发计划 §6.3）",
      "properties": {
        "scale": {
          "type": "object",
          "required": ["min", "max", "step"],
          "properties": {
            "min": { "type": "number", "description": "最小分（如 1）" },
            "max": { "type": "number", "description": "最大分（如 5）" },
            "step": { "type": "number", "description": "步进（如 0.5）" }
          },
          "additionalProperties": false
        },
        "blockThreshold": {
          "type": "number",
          "description": "阻断阈值：任一角度 ≤ 该值识别为阻断性问题（默认 2.0）"
        },
        "anchorSource": {
          "type": "string",
          "description": "默认锚点来源文档路径（仅作默认参考，不构成事实引用）"
        }
      },
      "additionalProperties": false
    },
    "aiConstraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "方法级 AI 约束（平台 AI 铁律不可放宽，只能追加，见 §6.4）"
    },
    "outputContract": {
      "type": "object",
      "description": "声明本方法覆盖的输出契约字段（字段全集见开发计划 §4）",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "enum": [
              "visionStatement",
              "visionNarrative",
              "ambitionTable",
              "ambitionRationale",
              "impactSummary",
              "openIssues",
              "validationPlan",
              "changeControl",
              "aiElements",
              "downstreamInterfaces",
              "diagnosisScope",
              "scoringConfig",
              "dimensionScores",
              "angleScores",
              "blockingIssues",
              "evidenceList",
              "improvementPath",
              "overallScore",
              "reportNarrative"
            ]
          },
          "description": "本方法承诺必填的契约字段（缺失核心字段阻断进入确认）"
        },
        "optional": {
          "type": "array",
          "items": {
            "enum": [
              "visionStatement",
              "visionNarrative",
              "ambitionTable",
              "ambitionRationale",
              "impactSummary",
              "openIssues",
              "validationPlan",
              "changeControl",
              "aiElements",
              "downstreamInterfaces",
              "diagnosisScope",
              "scoringConfig",
              "dimensionScores",
              "angleScores",
              "blockingIssues",
              "evidenceList",
              "improvementPath",
              "overallScore",
              "reportNarrative"
            ]
          },
          "description": "本方法可选的契约字段"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
